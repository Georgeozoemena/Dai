{
  "expo": {
    "name": "Dai",
    "slug": "Dai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/MOVA.jpg",
    "userInterfaceStyle": "light",
    "scheme": "dai",
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#FBCC33",
      "androidMode": "default",
      "androidCollapsedTitle": "{{unread_count}} new notifications"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock Dai and access your financial data securely.",
        "NSCameraUsageDescription": "Allow Dai to access your camera to take profile pictures.",
        "NSPhotoLibraryUsageDescription": "Allow Dai to access your photo library to select profile pictures."
      }
    },
    "android": {
      "package": "com.dai.finance",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/MOVA-white.png",
        "backgroundImage": "./assets/MOVA-black.png",
        "monochromeImage": "./assets/MOVA-white.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/MOVA.jpg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dai to access your photos to set your profile picture.",
          "cameraPermission": "Allow Dai to access your camera to take profile pictures."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FBCC33",
          "sounds": []
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "image/jpeg",
              "image/png"
            ],
            "multipleShareMimeTypes": [
              "application/pdf",
              "image/jpeg",
              "image/png"
            ]
          }
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "39f95537-c3b5-44f3-b790-f09203768ffc"
      },
      "EXPO_PUBLIC_BACKEND_URL": "http://localhost:5000",
      "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "900527916230-v37hfl119bs0gld3l91berjl6t3veo8a.apps.googleusercontent.com"
    }
  }
}
